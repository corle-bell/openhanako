# Electron 桌面端（Docker 不需要的 Electron 特定文件）
desktop/main.cjs
desktop/bootstrap.cjs
desktop/preload.cjs
desktop/main.bundle.cjs
desktop/preload.bundle.cjs
desktop/entitlements.mac.plist
desktop/src/shared/

# 构建脚本（保留 postinstall 需要的脚本）
scripts/*
!scripts/patch-pi-sdk.cjs

# 安装器
build/
vendor/

# 构建产物（非 Web）
dist/
dist-server/
dist-renderer/
dist-computer-use/
dist-sandbox/

# 测试
tests/
examples/
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.test.js

# 文档
.docs/
*.md
!README.md

# 开发工具
.eslintrc*
.eslintignore
.prettierrc*
.editorconfig
.npmrc
.git/
.gitignore
.github/
node_modules/.cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# Docker 自身（保留 Dockerfile 和 entrypoint.sh 等构建所需文件）
docker/*
!docker/Dockerfile
!docker/entrypoint.sh
!docker/nginx.conf
!docker/docker-compose.yml

# vite.config.ts（Electron 构建用，Web 用 vite.config.web.ts）
vite.config.ts
vite.config.theme.js
vite.config.preload.js
vite.config.main.js
